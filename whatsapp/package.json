{
  "name": "wallbit-ai-dashboard",
  "version": "2.0.0",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "build:css": "tailwindcss -i ./public/assets/css/input.css -o ./public/assets/css/app.css --minify",
    "dev:css": "tailwindcss -i ./public/assets/css/input.css -o ./public/assets/css/app.css --watch",
    "tunnel": "node src/utils/tunnel.js",
    "dev:tunnel": "node src/utils/tunnel.js --start",
    "postinstall": "npm run build:css"
  },
  "keywords": ["whatsapp", "wallbit", "baileys", "saas", "dashboard"],
  "author": "",
  "license": "ISC",
  "description": "Wallbit AI Dashboard — Enterprise SaaS Platform",
    "dependencies": {
        "@whiskeysockets/baileys": "^7.0.0-rc13",
        "alpinejs": "^3.14.9",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "flowbite": "^2.5.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
