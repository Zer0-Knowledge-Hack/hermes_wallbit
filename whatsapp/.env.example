# Server
PORT=3000
NODE_ENV=development
# Al usar `npm run dev:tunnel` o `npm run tunnel`, BASE_URL se actualizará automáticamente a la URL HTTPS pública (ej: https://xxx.trycloudflare.com)
BASE_URL=http://localhost:3000

# Security — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change_me_to_a_64_char_hex_string_for_aes256_gcm_encryption
JWT_SECRET=change_me_to_a_random_jwt_secret_string

# Wallbit REST API (X-API-Key per user — NOT the MCP token wlb_live_...)
WALLBIT_API_BASE=https://api.wallbit.io
WALLBIT_API_PREFIX=/api/public/v1

# Connect link expiry (minutes)
CONNECT_LINK_EXPIRY_MINUTES=5

# Admin dashboard credentials (change in production)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
