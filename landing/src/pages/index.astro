---
import "../styles/global.css";

const botUrl = import.meta.env.PUBLIC_BOT_URL ?? "https://t.me/hermes_wallbit_bot";

// A Short embeds like any other video once you use the plain video id.
const demoId = "1tpZbPSa8DY";
const demoUrl = `https://youtube.com/shorts/${demoId}`;

// WhatsApp CTA is off while the channel is in maintenance. Restore the URL when
// the Zavu/Meta integration is live again.
// const whatsappUrl = "https://wa.me/59170986680?text=Hola";

const steps = [
  {
    n: "01",
    title: "Conectás tu cuenta",
    body: "Generás una API key en Wallbit y la pegás en un enlace de un solo uso. Queda cifrada.",
  },
  {
    n: "02",
    title: "Hermes vigila",
    body: "Revisa tu cuenta cada pocas horas. No tenés que abrir nada ni acordarte de nada.",
  },
  {
    n: "03",
    title: "Te escribe",
    body: "Cuando entra dinero te avisa con el monto real y cuánto quedó sin invertir.",
  },
  {
    n: "04",
    title: "Confirmás vos",
    body: "La orden sale solo si tocás el botón, sobre los números exactos que viste.",
  },
];

const segments = [
  {
    title: "Cobrás sueldo del exterior",
    body: "Te pagan todos los meses en Wallbit. Estás fuera del sistema de pensiones y no hay nadie ahorrando por vos.",
  },
  {
    title: "Facturás como freelancer",
    body: "Montos variables, fechas irregulares. Sostener un hábito de inversión cuando el ingreso no es parejo es difícil sin ayuda.",
  },
  {
    title: "Invertís desde Bolivia",
    body: "Cargás bolivianos para tener dólares digitales y acceder al mercado estadounidense, pero no sabés por dónde arrancar.",
  },
];

const differences = [
  {
    n: "01",
    title: "Llega antes que la duda",
    body: "No espera a que abras la sección de inversiones. Te busca en el momento exacto en que entró la plata, que es cuando la decisión se toma o se posterga para siempre.",
  },
  {
    n: "02",
    title: "Conoce tus números",
    body: "Ve tu saldo, tu cartera y tu historial reales. No da consejos genéricos: te habla de la plata que tenés hoy, con el precio de hoy.",
  },
  {
    n: "03",
    title: "Vive donde ya estás",
    body: "Todo ocurre en Telegram. Sin instalar nada, sin otra contraseña, sin una app más compitiendo por tu atención.",
  },
];

const security = [
  {
    k: "Cifrada",
    body: "Tu API key se guarda cifrada y solo se usa para leer tu cuenta y ejecutar lo que confirmás.",
  },
  {
    k: "Nunca sin vos",
    body: "Ninguna orden se envía sin que toques el botón, y siempre sobre cifras que ya viste en pantalla.",
  },
  {
    k: "Sin salida",
    body: "Hermes no puede retirar dinero ni transferirlo a terceros. La API de Wallbit sencillamente no lo permite.",
  },
  {
    k: "Reversible",
    body: "Quitás el acceso cuando quieras, y podés pedirle a Wallbit que elimine la credencial por completo.",
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hermes · Tu plata en Wallbit, trabajando</title>
    <meta
      name="description"
      content="Agente de Telegram que lee tu cuenta de Wallbit, te avisa cuando entra plata y te acompaña a decidir dónde invertirla."
    />
    <meta property="og:title" content="Hermes · Tu plata en Wallbit, trabajando" />
    <meta
      property="og:description"
      content="Cobrás del exterior en Wallbit. Hermes te avisa cuando entra plata y te acompaña a invertirla, desde Telegram."
    />
    <meta property="og:type" content="website" />
    <meta property="og:video" content={demoUrl} />
    <meta name="theme-color" content="#f7f4f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17151a" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Applied before first paint: reading localStorage after render would show
      // a flash of the wrong theme.
      try {
        const saved = localStorage.getItem("hermes-theme");
        if (saved === "light" || saved === "dark") {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>
  </head>

  <body>
    <div class="topbar">
      <div class="wrap topbar-inner">
        <a class="wordmark" href="/">Hermes<span>.</span></a>
        <button
          class="theme-toggle"
          type="button"
          id="theme-toggle"
          aria-label="Cambiar entre modo claro y oscuro"
        >
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>
      </div>
    </div>
    <!-- Hero -->
    <header class="hero">
      <div class="wrap hero-grid">
        <div>
          <span class="label">Hermes · para Bolivia</span>
          <h1>Tu plata llega.<br /><em>Y ahí se queda.</em></h1>
          <p>
            Hermes lee tu cuenta de Wallbit, te avisa apenas entra dinero y te acompaña
            a decidir qué hacer con él. Todo en Telegram, sin abrir otra app.
          </p>
          <div class="actions">
            <a class="cta" href={botUrl}>
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                ><path
                  d="M21.9 4.3 18.7 19c-.2 1-.9 1.3-1.8.8l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.4-.1-.6-.6-.2L6.3 12.7l-4.8-1.5c-1-.3-1-1 .2-1.5l18.8-7.2c.9-.3 1.6.2 1.4 1.8z"
                ></path></svg
              >
              Abrir en Telegram
            </a>
            <span class="cta-ghost cta-disabled" aria-disabled="true">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
                ><path
                  d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-1.7-.9-2.9-1.6-4-3.6-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5s-.7-1.6-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5 1.9.8 2.6.9 3.5.7.6-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.2-.3-.2-.6-.4z"
                ></path><path
                  d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2z"
                ></path></svg
              >
              WhatsApp · En mantenimiento
            </span>
          </div>
          <p class="cta-sub" style="margin-top: 16px;">
            <a href="#demo" class="demo-link">▶ Ver la demo</a> · Gratis, con tu propia API key
          </p>
        </div>

        <div class="phone" aria-label="Conversación de ejemplo con Hermes">
          <div class="screen">
            <div class="msg bot d1">
              💸 <b>Te entraron $500.00</b><br />
              Julio, tenés <b>$520.00</b> sin invertir.<br />¿Vemos qué hacer con eso?
            </div>
            <div class="keys d2">
              <span class="key">🔎 Ver opciones</span>
              <span class="key">💰 Mi cuenta</span>
            </div>
            <div class="msg me d3">Algo diversificado, unos $200</div>
            <div class="msg bot d4">
              <b>SPY</b> sigue al S&amp;P 500. Hoy $738.93.<br />
              Con $200 → comisión $1.00, quedan $199.00.<br />
              Son <b>0.2694 acciones</b>. Te alcanza.
            </div>
            <div class="keys d5">
              <span class="key go">✅ Comprar $200 de SPY</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Statement -->
    <section class="statement">
      <div class="wrap statement-grid reveal">
        <div>
          <span class="label">El problema</span>
          <h2 style="margin: 20px 0 22px;">Cobrar ya está resuelto.<br />Lo que sigue, no.</h2>
          <p>
            Wallbit hace que te paguen del exterior, que tengas dólares y que pagues con
            QR en Bolivia. Lo que no existe es el puente entre que entra la plata y que
            se convierte en patrimonio. Hoy ese puente depende de que te acuerdes, de
            que sepas qué elegir y de que lo hagas.
          </p>
        </div>

        <div class="ledger">
          <div class="ledger-row head"><span>Movimiento</span><span>Estado</span></div>
          <div class="ledger-row"><span>Pago recibido · $500.00</span><b>Acreditado</b></div>
          <div class="ledger-row"><span>Día 3</span><span class="idle">Sin mover</span></div>
          <div class="ledger-row"><span>Día 11</span><span class="idle">Sin mover</span></div>
          <div class="ledger-row"><span>Día 26</span><span class="idle">Sin mover</span></div>
          <div class="ledger-row"><span>Próximo pago</span><b>$500.00</b></div>
        </div>
      </div>
    </section>

    <!-- Demo -->
    <section class="demo" id="demo">
      <div class="wrap demo-grid reveal">
        <div>
          <span class="label">La demo</span>
          <h2 style="margin: 20px 0 22px;">Vas a verlo funcionando.</h2>
          <p>
            Una conversación real en Telegram: Hermes lee la cuenta, muestra
            instrumentos con su precio de hoy, calcula cuánto se lleva la comisión y
            deja la compra lista para confirmar con un botón.
          </p>
          <a class="cta-ghost" href={demoUrl} target="_blank" rel="noopener">
            Abrir en YouTube →
          </a>
        </div>

        <div class="demo-phone">
          <div class="demo-frame">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${demoId}`}
              title="Demo de Hermes en Telegram"
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- Steps -->
    <section class="steps">
      <div class="wrap">
        <span class="label">Cómo funciona</span>
        <h2 style="margin-top: 20px;">
          Cuatro pasos, y después nada.
        </h2>
        <div class="steps-list reveal">
          {
            steps.map((step) => (
              <div class="step">
                <span class="n">{step.n}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Segments -->
    <section class="segments">
      <div class="wrap">
        <span class="label">Para quién</span>
        <h2 style="margin: 20px 0 40px;">
          Gente que cobra en dólares<br />y no tiene quién la acompañe.
        </h2>
        <div class="reveal">
          {
            segments.map((segment) => (
              <div class="segment">
                <h3>{segment.title}</h3>
                <p>{segment.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Difference -->
    <section class="diff">
      <div class="wrap">
        <span class="label">La diferencia</span>
        <h2 style="margin: 20px 0 12px;">
          No es otro chat.
        </h2>
        <div class="reveal">
          {
            differences.map((item) => (
              <div class="diff-row">
                <span class="num">{item.n}</span>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Security -->
    <section class="security">
      <div class="wrap">
        <span class="label">Tu dinero</span>
        <h2 style="margin-top: 20px;">
          Hermes propone.<br />Vos disponés.
        </h2>
        <div class="sec-grid reveal">
          {
            security.map((item) => (
              <div class="sec">
                <span class="k">{item.k}</span>
                <p>{item.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Close -->
    <section class="close">
      <div class="wrap">
        <h2>Que tu plata no espere.</h2>
        <p>Conectá tu cuenta en dos minutos y empezá a decidir con datos reales.</p>
        <div class="actions" style="justify-content: center;">
          <a class="cta" href={botUrl}>Abrir en Telegram →</a>
          <span class="cta-ghost cta-disabled" aria-disabled="true">
            WhatsApp · En mantenimiento
          </span>
        </div>
      </div>
    </section>

    <footer>
      <div class="wrap">
        <div class="foot">
          <span>Hermes</span>
          <span>Construido sobre la API pública de Wallbit</span>
        </div>
        <p class="disclaimer">
          Hermes es una herramienta de información y automatización. No constituye
          asesoramiento financiero ni garantiza resultado alguno. Toda inversión implica
          riesgo de pérdida, y el comportamiento pasado de un instrumento no predice su
          comportamiento futuro. Las decisiones y su ejecución son siempre del usuario.
        </p>
      </div>
    </footer>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;

        // With no explicit choice yet, flip away from whatever the OS is showing.
        const current =
          root.dataset.theme ??
          (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");

        const next = current === "dark" ? "light" : "dark";
        root.dataset.theme = next;

        try {
          localStorage.setItem("hermes-theme", next);
        } catch {}
      });
    </script>
  </body>
</html>
